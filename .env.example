# Домен сайта. DNS должен указывать на этот сервер, порты 80 и 443 открыты:
# Caddy сам получит и будет продлевать сертификат.
DOMAIN=gazeta.example.com

# Часовой пояс для дат на сайте.
TZ=Europe/Moscow

# Девиз под названием газеты (необязательно).
SITE_MOTTO=Традиция, порядок и правда Девяти Штатов

# Ограничения на изображения в одном материале.
MAX_IMAGE_MB=5
MAX_IMAGES=6

# Порт служебного API на 127.0.0.1 сервера (создание админов).
INTERNAL_PORT=9090

# Поставьте false, только если сайт открыт по http без TLS (например, DOMAIN=:80):
# иначе браузер не сохранит вход админа.
COOKIE_SECURE=true

# Порты Caddy на сервере.
HTTP_PORT=80
HTTPS_PORT=443
